<UserControl x:Class="FlatPlate.App.Views.AuthenticationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Border Padding="48"
                Background="#173D2B">
            <StackPanel MaxWidth="360"
                        VerticalAlignment="Center">
                <Border Width="64"
                        Height="64"
                        HorizontalAlignment="Left"
                        Background="#D9F0E2"
                        CornerRadius="32">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#173D2B"
                               Text="F" />
                </Border>
                <TextBlock Margin="0,24,0,0"
                           FontSize="38"
                           FontWeight="Bold"
                           Foreground="White"
                           Text="FlatPlate" />
                <TextBlock Margin="0,12,0,0"
                           FontSize="18"
                           Foreground="#D4E5DB"
                           TextWrapping="Wrap"
                           Text="Plan a week of meals, combine your ingredients, and keep the grocery bill under control." />
                <StackPanel Margin="0,36,0,0">
                    <TextBlock Margin="0,0,0,12"
                               Foreground="#BFD8CA"
                               Text="✓ Seven-day meal planning" />
                    <TextBlock Margin="0,0,0,12"
                               Foreground="#BFD8CA"
                               Text="✓ One combined shopping list" />
                    <TextBlock Foreground="#BFD8CA"
                               Text="✓ Supermarket price comparison" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">
            <Grid MinHeight="620"
                  Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Width="460"
                        Padding="38"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="White"
                        CornerRadius="16">
                    <Grid>
                        <StackPanel Visibility="{Binding IsSignInVisible,
                                                         Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="#173D2B"
                                       Text="Welcome back" />
                            <TextBlock Margin="0,6,0,24"
                                       Foreground="#66736B"
                                       Text="Sign in to continue planning your week." />

                            <TextBlock Margin="0,0,0,6"
                                       FontWeight="SemiBold"
                                       Text="Email" />
                            <TextBox Style="{StaticResource FormTextBox}"
                                     Text="{Binding Email,
                                                    UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,16,0,6"
                                       FontWeight="SemiBold"
                                       Text="Password" />
                            <PasswordBox x:Name="SignInPassword"
                                         Style="{StaticResource FormPasswordBox}" />

                            <Button Margin="0,22,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding CanSubmit}"
                                    Click="SignIn_Click"
                                    Content="Sign in" />
                            <Button Margin="0,10,0,0"
                                    Padding="4"
                                    HorizontalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#2F7D57"
                                    Command="{Binding ShowResetPasswordCommand}"
                                    Content="Forgot your password?" />
                            <Button Margin="0,4,0,0"
                                    Padding="4"
                                    HorizontalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#2F7D57"
                                    Command="{Binding ShowVerifyEmailCommand}"
                                    Content="Verify your email" />

                            <Separator Margin="0,18" />
                            <StackPanel HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           Text="New to FlatPlate?" />
                                <Button Margin="5,0,0,0"
                                        Padding="4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        Foreground="#2F7D57"
                                        Command="{Binding ShowRegisterCommand}"
                                        Content="Create an account" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsRegisterVisible,
                                                         Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="#173D2B"
                                       Text="Create your account" />
                            <TextBlock Margin="0,6,0,22"
                                       Foreground="#66736B"
                                       Text="Keep your plans available whenever you sign in." />

                            <TextBlock Margin="0,0,0,6"
                                       FontWeight="SemiBold"
                                       Text="Display name" />
                            <TextBox Style="{StaticResource FormTextBox}"
                                     Text="{Binding DisplayName,
                                                    UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,14,0,6"
                                       FontWeight="SemiBold"
                                       Text="Email" />
                            <TextBox Style="{StaticResource FormTextBox}"
                                     Text="{Binding Email,
                                                    UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,14,0,6"
                                       FontWeight="SemiBold"
                                       Text="Password" />
                            <PasswordBox x:Name="RegisterPassword"
                                         Style="{StaticResource FormPasswordBox}" />
                            <TextBlock Margin="0,5,0,0"
                                       FontSize="11"
                                       Foreground="#738078"
                                       Text="10–128 characters with uppercase, lowercase, and a number." />
                            <TextBlock Margin="0,14,0,6"
                                       FontWeight="SemiBold"
                                       Text="Confirm password" />
                            <PasswordBox x:Name="RegisterConfirmPassword"
                                         Style="{StaticResource FormPasswordBox}" />

                            <Button Margin="0,22,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding CanSubmit}"
                                    Click="Register_Click"
                                    Content="Create account" />
                            <Button Margin="0,8,0,0"
                                    Padding="4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#2F7D57"
                                    Command="{Binding ShowSignInCommand}"
                                    Content="Back to sign in" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsVerifyEmailVisible,
                                                         Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="#173D2B"
                                       Text="Verify your email" />
                            <TextBlock Margin="0,6,0,24"
                                       Foreground="#66736B"
                                       TextWrapping="Wrap"
                                       Text="Enter the one-time code sent to your email address." />

                            <TextBlock Margin="0,0,0,6"
                                       FontWeight="SemiBold"
                                       Text="Email" />
                            <TextBox Style="{StaticResource FormTextBox}"
                                     Text="{Binding Email,
                                                    UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,16,0,6"
                                       FontWeight="SemiBold"
                                       Text="Verification code" />
                            <TextBox MaxLength="6"
                                     FontSize="20"
                                     CharacterCasing="Upper"
                                     Style="{StaticResource FormTextBox}"
                                     Text="{Binding VerificationCode,
                                                    UpdateSourceTrigger=PropertyChanged}" />

                            <Button Margin="0,22,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding CanSubmit}"
                                    Click="VerifyEmail_Click"
                                    Content="Verify email" />
                            <Button Margin="0,10,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    IsEnabled="{Binding CanSubmit}"
                                    Click="ResendVerification_Click"
                                    Content="Send a new code" />
                            <Button Margin="0,8,0,0"
                                    Padding="4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#2F7D57"
                                    Command="{Binding ShowSignInCommand}"
                                    Content="Back to sign in" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsResetPasswordVisible,
                                                         Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="#173D2B"
                                       Text="Reset your password" />
                            <TextBlock Margin="0,6,0,22"
                                       Foreground="#66736B"
                                       TextWrapping="Wrap"
                                       Text="Request a code, then choose a new password." />

                            <TextBlock Margin="0,0,0,6"
                                       FontWeight="SemiBold"
                                       Text="Email" />
                            <TextBox Style="{StaticResource FormTextBox}"
                                     Text="{Binding Email,
                                                    UpdateSourceTrigger=PropertyChanged}" />
                            <Button Margin="0,10,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    IsEnabled="{Binding CanSubmit}"
                                    Click="RequestReset_Click"
                                    Content="Send reset code" />

                            <TextBlock Margin="0,18,0,6"
                                       FontWeight="SemiBold"
                                       Text="Reset code" />
                            <TextBox MaxLength="6"
                                     Style="{StaticResource FormTextBox}"
                                     Text="{Binding ResetCode,
                                                    UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,14,0,6"
                                       FontWeight="SemiBold"
                                       Text="New password" />
                            <PasswordBox x:Name="ResetPassword"
                                         Style="{StaticResource FormPasswordBox}" />
                            <TextBlock Margin="0,14,0,6"
                                       FontWeight="SemiBold"
                                       Text="Confirm new password" />
                            <PasswordBox x:Name="ResetConfirmPassword"
                                         Style="{StaticResource FormPasswordBox}" />

                            <Button Margin="0,22,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding CanSubmit}"
                                    Click="ResetPassword_Click"
                                    Content="Set new password" />
                            <Button Margin="0,8,0,0"
                                    Padding="4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#2F7D57"
                                    Command="{Binding ShowSignInCommand}"
                                    Content="Back to sign in" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Width="460"
                        Margin="0,16,0,0"
                        Padding="14,10"
                        HorizontalAlignment="Center"
                        Background="#FFF4D8"
                        CornerRadius="8"
                        Visibility="{Binding StatusMessage,
                                             Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Foreground="#6E5314"
                               TextWrapping="Wrap"
                               Text="{Binding StatusMessage}" />
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
