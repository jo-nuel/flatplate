<UserControl x:Class="FlatPlate.App.Views.PriceBookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FlatPlate.App.ViewModels"
             Background="#F3F8F2">
    <!-- starts empty; prices are supplied through PriceBookViewModel.LoadPrices -->
    <UserControl.DataContext>
        <vm:PriceBookViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- white bordered panel used for the price table -->
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D5E3D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Price Book"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,4" />

            <TextBlock Text="Keep supermarket pack prices for each ingredient. All prices are in AUD."
                       Foreground="#4F5F4C"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- toolbar: the store filter narrows the table; no editing or CSV behaviour yet -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label x:Name="StoreFilterLabel"
                   Grid.Column="0"
                   Content="_Store"
                   Target="{Binding ElementName=StoreFilterComboBox}"
                   Padding="0"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0" />

            <!-- Label.Target only provides the Alt+S access key; LabeledBy gives screen readers the name -->
            <ComboBox x:Name="StoreFilterComboBox"
                      Grid.Column="1"
                      AutomationProperties.LabeledBy="{Binding ElementName=StoreFilterLabel}"
                      ItemsSource="{Binding StoreOptions}"
                      SelectedItem="{Binding SelectedStore}"
                      Padding="8,5"
                      VerticalContentAlignment="Center" />

            <!-- price entry actions; Edit is enabled only while a price row is selected -->
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        Margin="16,0,0,0">
                <Button x:Name="AddPriceButton"
                        Content="Add Price"
                        Padding="14,7"
                        Margin="0,0,8,0" />

                <Button x:Name="EditPriceButton"
                        Content="Edit Price"
                        Padding="14,7">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=PriceEntriesDataGrid}"
                                             Value="{x:Null}">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- CSV actions; Export is enabled only while the table has rows -->
            <StackPanel Grid.Column="4"
                        Orientation="Horizontal"
                        Margin="24,0,0,0">
                <Button x:Name="ImportCsvButton"
                        Content="Import CSV"
                        Padding="14,7"
                        Margin="0,0,8,0" />

                <Button x:Name="ExportCsvButton"
                        Content="Export CSV"
                        Padding="14,7">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=PriceEntriesDataGrid}"
                                             Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- price table with an empty-state message layered on top -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <!-- the own collection view would otherwise auto-select its first row and enable Edit -->
                <DataGrid x:Name="PriceEntriesDataGrid"
                          AutomationProperties.Name="Price entries"
                          ItemsSource="{Binding VisiblePrices}"
                          SelectedItem="{Binding SelectedPrice}"
                          IsSynchronizedWithCurrentItem="False"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E3ECE1"
                          Background="White"
                          BorderThickness="0">
                    <DataGrid.Resources>
                        <Style x:Key="NumericCellTextStyle" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ingredient"
                                            Binding="{Binding IngredientName}"
                                            Width="*"
                                            MinWidth="150" />

                        <DataGridTextColumn Header="Store"
                                            Binding="{Binding StoreName}"
                                            Width="100" />

                        <DataGridTextColumn Header="Price (AUD)"
                                            Binding="{Binding Price, StringFormat={}{0:0.00}}"
                                            ElementStyle="{StaticResource NumericCellTextStyle}"
                                            Width="90" />

                        <!-- sorts by the numeric pack size rather than the "500 g" text -->
                        <DataGridTextColumn Header="Pack size"
                                            Binding="{Binding PackSizeDisplay}"
                                            SortMemberPath="PackSize"
                                            ElementStyle="{StaticResource NumericCellTextStyle}"
                                            Width="80" />

                        <DataGridTextColumn Header="Updated"
                                            Binding="{Binding LastUpdated, StringFormat={}{0:dd MMM yyyy}}"
                                            Width="105" />

                        <DataGridTextColumn Header="Source"
                                            Binding="{Binding Source}"
                                            Width="100" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- empty price book message, hidden automatically once the table has rows;
                     the top margin keeps it clear of the column headers -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="380"
                        Margin="12,44,12,12"
                        Padding="24,20"
                        Background="#F3F8F2"
                        BorderBrush="#D5E3D1"
                        BorderThickness="1"
                        CornerRadius="6"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=PriceEntriesDataGrid}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <TextBlock Text="No prices yet"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#2F4A2C"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />

                        <TextBlock Text="Add a price or import a CSV file to build your price book."
                                   Foreground="#4F5F4C"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
