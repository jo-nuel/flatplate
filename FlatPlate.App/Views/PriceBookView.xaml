<UserControl x:Class="FlatPlate.App.Views.PriceBookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FlatPlate.App.ViewModels"
             Background="#F3F8F2">
    <!-- starts empty; prices are supplied through PriceBookViewModel.LoadPrices -->
    <UserControl.DataContext>
        <vm:PriceBookViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- white bordered panel used for the price table -->
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D5E3D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="ConnectedButtonStyle" TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Actions}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Price Book"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,4" />

            <TextBlock Text="Keep supermarket pack prices for each ingredient. All prices are in AUD."
                       Foreground="#4F5F4C"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- host-supplied actions prepare drafts, export visible rows and preview import -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label x:Name="StoreFilterLabel"
                   Grid.Column="0"
                   Content="_Store"
                   Target="{Binding ElementName=StoreFilterComboBox}"
                   Padding="0"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0" />

            <!-- Label.Target only provides the Alt+S access key; LabeledBy gives screen readers the name -->
            <ComboBox x:Name="StoreFilterComboBox"
                      Grid.Column="1"
                      AutomationProperties.LabeledBy="{Binding ElementName=StoreFilterLabel}"
                      ItemsSource="{Binding StoreOptions}"
                      SelectedItem="{Binding SelectedStore}"
                      Padding="8,5"
                      VerticalContentAlignment="Center" />

            <!-- price entry actions; Edit is enabled only while a price row is selected -->
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        Margin="16,0,0,0">
                <Button x:Name="AddPriceButton"
                        Content="_Add Price"
                        AutomationProperties.Name="Add Price"
                        Command="{Binding Actions.AddPriceCommand}"
                        Style="{StaticResource ConnectedButtonStyle}"
                        Padding="14,7"
                        Margin="0,0,8,0" />

                <Button x:Name="EditPriceButton"
                        Content="_Edit Price"
                        AutomationProperties.Name="Edit Price"
                        Command="{Binding Actions.EditPriceCommand}"
                        Padding="14,7">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ConnectedButtonStyle}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=PriceEntriesDataGrid}"
                                             Value="{x:Null}">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- CSV actions; Export is enabled only while the table has rows -->
            <StackPanel Grid.Column="4"
                        Orientation="Horizontal"
                        Margin="24,0,0,0">
                <Button x:Name="ImportCsvButton"
                        Content="_Import CSV"
                        AutomationProperties.Name="Import prices from CSV"
                        Command="{Binding Actions.ImportCsvCommand}"
                        Style="{StaticResource ConnectedButtonStyle}"
                        Padding="14,7"
                        Margin="0,0,8,0" />

                <Button x:Name="ExportCsvButton"
                        Content="E_xport CSV"
                        AutomationProperties.Name="Export visible CSV rows"
                        Command="{Binding Actions.ExportCsvCommand}"
                        Padding="14,7"
                        Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ConnectedButtonStyle}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=PriceEntriesDataGrid}"
                                             Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="ReloadPricesButton"
                        Content="_Refresh"
                        AutomationProperties.Name="Refresh Price Book"
                        Command="{Binding Actions.ReloadCommand}"
                        Style="{StaticResource ConnectedButtonStyle}"
                        Padding="14,7" />
            </StackPanel>
        </Grid>

        <!-- price table with an empty-state message layered on top -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <!-- the own collection view would otherwise auto-select its first row and enable Edit -->
                <DataGrid x:Name="PriceEntriesDataGrid"
                          AutomationProperties.Name="Price entries"
                          ItemsSource="{Binding VisiblePrices}"
                          SelectedItem="{Binding SelectedPrice}"
                          IsSynchronizedWithCurrentItem="False"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E3ECE1"
                          Background="White"
                          BorderThickness="0">
                    <DataGrid.Resources>
                        <Style x:Key="NumericCellTextStyle" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ingredient"
                                            Binding="{Binding IngredientName}"
                                            Width="*"
                                            MinWidth="150" />

                        <DataGridTextColumn Header="Store"
                                            Binding="{Binding StoreName}"
                                            Width="100" />

                        <DataGridTextColumn Header="Price (AUD)"
                                            Binding="{Binding Price, StringFormat={}{0:0.00}}"
                                            ElementStyle="{StaticResource NumericCellTextStyle}"
                                            Width="90" />

                        <!-- sorts by the numeric pack size rather than the "500 g" text -->
                        <DataGridTextColumn Header="Pack size"
                                            Binding="{Binding PackSizeDisplay}"
                                            SortMemberPath="PackSize"
                                            ElementStyle="{StaticResource NumericCellTextStyle}"
                                            Width="140" />

                        <DataGridTextColumn Header="Updated"
                                            Binding="{Binding LastUpdated, StringFormat={}{0:dd MMM yyyy}}"
                                            Width="105" />

                        <DataGridTextColumn Header="Source"
                                            Binding="{Binding Source}"
                                            Width="100" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- empty price book message, hidden automatically once the table has rows;
                     the top margin keeps it clear of the column headers -->
                <Border x:Name="EmptyPriceBookPanel" HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="380"
                        Margin="12,44,12,12"
                        Padding="24,20"
                        Background="#F3F8F2"
                        BorderBrush="#D5E3D1"
                        BorderThickness="1"
                        CornerRadius="6"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=PriceEntriesDataGrid}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <TextBlock x:Name="EmptyPriceBookTitle" Text="{Binding EmptyTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#2F4A2C"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />

                        <TextBlock Text="{Binding EmptyDescription}"
                                   Foreground="#4F5F4C"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" x:Name="OperationMessageText" Text="{Binding OperationMessage}"
                   Margin="0,10,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#4F5F4C" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOperationError}" Value="True">
                            <Setter Property="Foreground" Value="#B3261E" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Expander Grid.Row="4" x:Name="PendingDraftsPanel" Header="Pending drafts — not saved"
                  IsExpanded="True" Margin="0,10,0,0">
            <Expander.Style>
                <Style TargetType="Expander">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPendingDrafts}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Expander.Style>
            <StackPanel>
                <TextBlock Text="The drafts below are not saved. They remain in memory only while this screen is open."
                           TextWrapping="Wrap" Foreground="#4F5F4C" Margin="0,4,0,6" />
                <DataGrid x:Name="PendingDraftsDataGrid" ItemsSource="{Binding PendingDrafts}" MaxHeight="125"
                          AutomationProperties.Name="Pending price drafts, not saved"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Action" Binding="{Binding Draft.Mode}" Width="60" />
                        <DataGridTextColumn Header="Ingredient" Binding="{Binding IngredientName}" Width="*" />
                        <DataGridTextColumn Header="Store" Binding="{Binding StoreName}" Width="100" />
                        <DataGridTextColumn Header="Price (AUD)" Binding="{Binding PriceDisplay}" Width="110" />
                        <DataGridTextColumn Header="Pack" Binding="{Binding PackDisplay}" Width="180" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Expander>
    </Grid>
</UserControl>
