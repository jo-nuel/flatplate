<UserControl x:Class="FlatPlate.App.Views.WeeklyPlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PlannerNavButton"
               TargetType="Button">
            <Setter Property="Width"
                    Value="34" />
            <Setter Property="Height"
                    Value="34" />
            <Setter Property="Background"
                    Value="{StaticResource FlatPlateGreenSoftBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource FlatPlateGreenDarkBrush}" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="FontSize"
                    Value="18" />
            <Setter Property="Cursor"
                    Value="Hand" />
        </Style>

        <Style x:Key="PlannerInputLabel"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0,0,0,6" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{StaticResource FlatPlateMutedBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource FlatPlateCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,22,24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource FlatPlateGreenBrush}"
                               Text="MEAL PLANNING" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource FlatPlateInkBrush}"
                               Text="Weekly Planner" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{StaticResource FlatPlateMutedBrush}"
                               Text="Choose meals for seven days and track the estimated shop as you go." />
                </StackPanel>
                <Button Grid.Column="1"
                        MinWidth="105"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearWeekCommand}"
                        Content="Clear week" />
            </Grid>

            <Border Margin="0,18,0,0"
                    Style="{StaticResource SurfaceCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource PlannerInputLabel}"
                                   Text="WEEK" />
                        <TextBlock MinWidth="190"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource FlatPlateInkBrush}"
                                   Text="{Binding WeekRangeLabel}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource PlannerNavButton}"
                            Command="{Binding PreviousWeekCommand}"
                            Content="‹"
                            ToolTip="Previous week" />

                    <DatePicker Grid.Column="2"
                                Height="34"
                                Margin="8,0,0,0"
                                VerticalAlignment="Bottom"
                                SelectedDate="{Binding WeekStartDate,
                                                       Mode=TwoWay,
                                                       UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="3"
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource PlannerNavButton}"
                            Command="{Binding NextWeekCommand}"
                            Content="›"
                            ToolTip="Next week" />

                    <StackPanel Grid.Column="5">
                        <TextBlock Style="{StaticResource PlannerInputLabel}"
                                   Text="SUPERMARKET" />
                        <ComboBox Height="34"
                                  ItemsSource="{Binding AvailableStores}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedStore,
                                                         Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="7">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource FlatPlateInkBrush}"
                                       Text="{Binding WeeklyBudget,
                                                      StringFormat={}{0:C0}}" />
                            <TextBlock Style="{StaticResource PlannerInputLabel}"
                                       Margin="0"
                                       Text="WEEKLY BUDGET" />
                        </DockPanel>
                        <Slider Height="24"
                                Minimum="25"
                                Maximum="500"
                                TickFrequency="25"
                                IsSnapToTickEnabled="True"
                                Value="{Binding WeeklyBudget,
                                                Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Margin="0,12,0,0"
                         Columns="4">
                <Border Margin="0,0,6,0"
                        Padding="16"
                        Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabel}"
                                   Text="PLANNED" />
                        <TextBlock Style="{StaticResource MetricValue}"
                                   FontSize="20"
                                   Text="{Binding PlanningProgressText}" />
                    </StackPanel>
                </Border>
                <Border Margin="6,0"
                        Padding="16"
                        Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabel}"
                                   Text="ESTIMATED SPEND" />
                        <TextBlock Style="{StaticResource MetricValue}"
                                   FontSize="20"
                                   Text="{Binding BudgetResult.TotalCost,
                                                  StringFormat={}{0:C2}}" />
                    </StackPanel>
                </Border>
                <Border Margin="6,0"
                        Padding="16"
                        Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabel}"
                                   Text="BUDGET STATUS" />
                        <TextBlock Text="{Binding BudgetVarianceText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource MetricValue}">
                                    <Setter Property="FontSize"
                                            Value="20" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BudgetResult.IsOverBudget}"
                                                     Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource FlatPlateDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Margin="6,0,0,0"
                        Padding="16"
                        Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabel}"
                                   Text="MISSING PRICES" />
                        <TextBlock Style="{StaticResource MetricValue}"
                                   FontSize="20"
                                   Text="{Binding MissingPriceCount}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,12,0,0">
                <ProgressBar Height="8"
                             Minimum="0"
                             Maximum="100"
                             Background="#DFE8E2"
                             BorderThickness="0"
                             Value="{Binding DisplayPercentageUsed}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Foreground"
                                    Value="{StaticResource FlatPlateGreenBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BudgetResult.IsOverBudget}"
                                             Value="True">
                                    <Setter Property="Foreground"
                                            Value="{StaticResource FlatPlateDangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="20,0,20,14"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border MinWidth="154"
                                Margin="4"
                                CornerRadius="12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"
                                            Value="{StaticResource FlatPlateSurfaceBrush}" />
                                    <Setter Property="BorderBrush"
                                            Value="{StaticResource FlatPlateBorderBrush}" />
                                    <Setter Property="BorderThickness"
                                            Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}"
                                                     Value="True">
                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource FlatPlateGreenBrush}" />
                                            <Setter Property="BorderThickness"
                                                    Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border x:Name="DayHeader"
                                        Padding="12,11"
                                        CornerRadius="11,11,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="#F0F5F1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}"
                                                             Value="True">
                                                    <Setter Property="Background"
                                                            Value="{StaticResource FlatPlateGreenSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource FlatPlateInkBrush}"
                                                   Text="{Binding DayLabel}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource FlatPlateMutedBrush}"
                                                   Text="{Binding DateLabel}" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl Grid.Row="1"
                                              Margin="10,10,10,2"
                                              ItemsSource="{Binding MealSlots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="10"
                                                    Background="#F8FAF8"
                                                    BorderBrush="#E8EEE9"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,7">
                                                        <Button Width="22"
                                                                Height="22"
                                                                Padding="0"
                                                                DockPanel.Dock="Right"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Foreground="{StaticResource FlatPlateMutedBrush}"
                                                                Command="{Binding ClearCommand}"
                                                                Content="×"
                                                                ToolTip="Clear this meal" />
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource FlatPlateGreenDarkBrush}"
                                                                   Text="{Binding SlotLabel}" />
                                                    </DockPanel>
                                                    <ComboBox MinWidth="126"
                                                              Height="31"
                                                              ItemsSource="{Binding AvailableRecipes}"
                                                              DisplayMemberPath="Name"
                                                              SelectedItem="{Binding SelectedRecipe,
                                                                                     Mode=TwoWay}" />
                                                    <DockPanel Margin="0,8,0,0">
                                                        <TextBox Width="36"
                                                                 Height="28"
                                                                 DockPanel.Dock="Right"
                                                                 HorizontalContentAlignment="Center"
                                                                 VerticalContentAlignment="Center"
                                                                 Text="{Binding Servings,
                                                                                Mode=TwoWay,
                                                                                UpdateSourceTrigger=LostFocus}" />
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource FlatPlateMutedBrush}"
                                                                   Text="Servings" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2"
                Margin="24,0,24,16"
                Padding="12,8"
                Background="#FFF5DD"
                CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                            Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}"
                                     Value="">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Foreground="{StaticResource FlatPlateWarningBrush}"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
