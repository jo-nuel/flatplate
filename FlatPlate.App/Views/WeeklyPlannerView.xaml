<UserControl x:Class="FlatPlate.App.Views.WeeklyPlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F3F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Margin="20,20,20,12"
                Padding="18"
                Background="White"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Text="Weekly Planner" />
                    <StackPanel Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <TextBlock Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Text="Week starting" />
                        <Button Width="28"
                                Margin="0,0,6,0"
                                Command="{Binding PreviousWeekCommand}"
                                Content="‹"
                                ToolTip="Previous week" />
                        <DatePicker Width="150"
                                    SelectedDate="{Binding WeekStartDate,
                                                           Mode=TwoWay,
                                                           UpdateSourceTrigger=PropertyChanged}" />
                        <Button Width="28"
                                Margin="6,0,0,0"
                                Command="{Binding NextWeekCommand}"
                                Content="›"
                                ToolTip="Next week" />
                        <TextBlock Margin="24,0,10,0"
                                   VerticalAlignment="Center"
                                   Text="Supermarket" />
                        <ComboBox Width="150"
                                  ItemsSource="{Binding AvailableStores}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedStore,
                                                         Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0"
                                Orientation="Horizontal">
                        <TextBlock Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Text="Weekly budget" />
                        <Slider Width="260"
                                Minimum="25"
                                Maximum="500"
                                TickFrequency="25"
                                IsSnapToTickEnabled="True"
                                Value="{Binding WeeklyBudget,
                                                Mode=TwoWay}" />
                        <TextBlock Width="70"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding WeeklyBudget,
                                                  StringFormat={}{0:C0}}" />
                    </StackPanel>
                    <Grid Width="500"
                          Margin="0,12,0,0"
                          HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,5">
                            <TextBlock DockPanel.Dock="Right"
                                       Foreground="#596675">
                                <Run Text="Missing prices: " />
                                <Run Text="{Binding BudgetResult.MissingPriceItems.Count,
                                                    Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="Estimated spend: " />
                                <Run Text="{Binding BudgetResult.TotalCost,
                                                    Mode=OneWay,
                                                    StringFormat={}{0:C2}}" />
                            </TextBlock>
                        </DockPanel>

                        <ProgressBar Grid.Row="1"
                                     Height="12"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding BudgetResult.PercentageUsed,
                                                     Mode=OneWay}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground"
                                            Value="#3A8D5D" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BudgetResult.IsOverBudget}"
                                                     Value="True">
                                            <Setter Property="Foreground"
                                                    Value="#C94B40" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Grid.Row="2"
                                   Margin="0,5,0,0"
                                   HorizontalAlignment="Right"
                                   FontWeight="SemiBold"
                                   Foreground="#C94B40"
                                   Text="Over weekly budget">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BudgetResult.IsOverBudget}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <Button Grid.Column="1"
                        MinWidth="110"
                        Padding="12,7"
                        VerticalAlignment="Bottom"
                        Command="{Binding ClearWeekCommand}"
                        Content="Clear week" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Margin="20,0,20,12"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border MinWidth="145"
                                Margin="4"
                                Padding="12"
                                Background="White"
                                BorderBrush="#D9E1EA"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{Binding DayLabel}" />
                                <TextBlock Margin="0,2,0,10"
                                           HorizontalAlignment="Center"
                                           Foreground="#596675"
                                           Text="{Binding DateLabel}" />

                                <ItemsControl ItemsSource="{Binding MealSlots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10"
                                                    Padding="9"
                                                    Background="#F7F9FC"
                                                    CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Margin="0,0,0,5"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding SlotLabel}" />
                                                    <ComboBox ItemsSource="{Binding AvailableRecipes}"
                                                              DisplayMemberPath="Name"
                                                              SelectedItem="{Binding SelectedRecipe,
                                                                                     Mode=TwoWay}" />
                                                    <DockPanel Margin="0,7,0,0">
                                                        <Button Width="24"
                                                                Height="24"
                                                                Margin="8,0,0,0"
                                                                HorizontalAlignment="Right"
                                                                DockPanel.Dock="Right"
                                                                Command="{Binding ClearCommand}"
                                                                Content="×"
                                                                ToolTip="Clear this meal" />
                                                        <TextBlock Margin="0,0,6,0"
                                                                   VerticalAlignment="Center"
                                                                   Text="Serves" />
                                                        <TextBox Width="40"
                                                                 HorizontalContentAlignment="Center"
                                                                 Text="{Binding Servings,
                                                                                Mode=TwoWay,
                                                                                UpdateSourceTrigger=LostFocus}" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Margin="24,0,24,18"
                   Foreground="#A33A32"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
