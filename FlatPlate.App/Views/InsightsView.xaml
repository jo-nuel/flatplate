<UserControl x:Class="FlatPlate.App.Views.InsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F1F8" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Shopping Insights"
                   FontSize="28"
                   FontWeight="Bold"/>

            <TextBlock Text="Understand your shopping costs and food waste."
                   FontSize="14"
                   Foreground="#666666"
                   Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Insights content -->
        <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- Store Comparison -->
                <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,0,16">

                    <StackPanel>
                        <TextBlock Text="Store Comparison"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                        <TextBlock Text="Compare estimated shopping costs across supermarkets."
                               Foreground="#666666"
                               Margin="0,0,0,16"/>

                        <StackPanel x:Name="StoreComparisonChart">
                            <TextBlock Text="No comparison data available."
                                   Foreground="Gray"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Spend by Cuisine -->
                <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,0,16">

                    <StackPanel>
                        <TextBlock Text="Spend by Cuisine"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                        <TextBlock Text="Estimated spending for different cuisines."
                               Foreground="#666666"
                               Margin="0,0,0,16"/>

                        <StackPanel x:Name="CuisineSpendingChart">
                            <TextBlock Text="No cuisine data available."
                                   Foreground="Gray"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Waste Score -->
                <Border Background="White"
                    CornerRadius="10"
                    Padding="20">

                    <StackPanel>
                        <TextBlock Text="Waste Score"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                        <TextBlock Text="Estimated unused quantities from whole-pack purchases."
                               Foreground="#666666"
                               Margin="0,0,0,16"/>

                        <TextBlock x:Name="WasteScoreText"
                               Text="Not calculated"
                               FontSize="26"
                               FontWeight="Bold"/>

                    </StackPanel>
                </Border>

                <!-- ML.NET Price Estimator -->
                <Border Background="White"
        CornerRadius="10"
        Padding="20"
        Margin="0,16,0,0">

                    <StackPanel>
                        <TextBlock Text="ML.NET Price Estimator"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

                        <TextBlock Text="Predict supermarket product prices using a trained ML.NET model."
                   Foreground="#666666"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

                        <!-- Ingredient -->
                        <TextBlock Text="Ingredient"
                   FontWeight="SemiBold"/>

                        <ComboBox x:Name="IngredientComboBox"
                  Margin="0,5,0,12"
                  MinWidth="180"
                  HorizontalAlignment="Left"/>

                        <!-- Store -->
                        <TextBlock Text="Store"
                   FontWeight="SemiBold"/>

                        <ComboBox x:Name="StoreComboBox"
                  Margin="0,5,0,12"
                  MinWidth="180"
                  HorizontalAlignment="Left"/>

                        <!-- Pack Size -->
                        <TextBlock Text="Pack Size (g / mL / pieces)"
                   FontWeight="SemiBold"/>

                        <TextBox x:Name="PackSizeTextBox"
                 Text="1000"
                 Width="180"
                 HorizontalAlignment="Left"
                 Margin="0,5,0,12"/>

                        <!-- Prediction Button -->
                        <Button x:Name="PredictPriceButton"
                Content="Predict Price"
                Padding="14,8"
                HorizontalAlignment="Left"
                Margin="0,5,0,16"/>

                        <!-- Prediction Result -->
                        <TextBlock x:Name="PredictedPriceText"
                   Text="Predicted Price: Not calculated"
                   FontSize="18"
                   FontWeight="Bold"/>

                        <TextBlock Text="ML estimates are not verified supermarket prices."
                   Foreground="Gray"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
