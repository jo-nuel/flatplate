<UserControl x:Class="FlatPlate.App.Views.InsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource FlatPlateCanvasBrush}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1120"
                        Margin="24,22,24,32"
                        HorizontalAlignment="Center">
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Style="{StaticResource PageEyebrow}"
                               Text="PLAN PERFORMANCE" />
                    <TextBlock Style="{StaticResource PageTitle}"
                               Text="Insights" />
                    <TextBlock Style="{StaticResource PageDescription}"
                               Text="Compare supermarket costs, understand cuisine spending, and check potential waste." />
                </StackPanel>

                <Border Margin="0,0,0,14"
                        Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource FlatPlateInkBrush}"
                                   Text="Store comparison" />
                        <TextBlock Margin="0,5,0,16"
                                   Foreground="{StaticResource FlatPlateMutedBrush}"
                                   Text="Estimated cost of the current shopping list at each supermarket."
                                   TextWrapping="Wrap" />
                        <StackPanel x:Name="StoreComparisonChart">
                            <TextBlock Foreground="{StaticResource FlatPlateMutedBrush}"
                                       Text="Add meals to compare store prices." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,14"
                        Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource FlatPlateInkBrush}"
                                   Text="Spend by cuisine" />
                        <TextBlock Margin="0,5,0,16"
                                   Foreground="{StaticResource FlatPlateMutedBrush}"
                                   Text="Estimated ingredient spending grouped by the cuisines in your plan."
                                   TextWrapping="Wrap" />
                        <StackPanel x:Name="CuisineSpendingChart">
                            <TextBlock Foreground="{StaticResource FlatPlateMutedBrush}"
                                       Text="Add meals to see cuisine spending." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource SurfaceCard}">
                        <StackPanel>
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource FlatPlateInkBrush}"
                                       Text="Waste score" />
                            <TextBlock Margin="0,5,0,18"
                                       Foreground="{StaticResource FlatPlateMutedBrush}"
                                       Text="Potential surplus caused by buying whole packs."
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="WasteScoreText"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource FlatPlateGreenDarkBrush}"
                                       Text="Not calculated" />
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource FlatPlateMutedBrush}"
                                       Text="Lower is better"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource SurfaceCard}">
                        <StackPanel>
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource FlatPlateInkBrush}"
                                       Text="Price estimator" />
                            <TextBlock Margin="0,5,0,16"
                                       Foreground="{StaticResource FlatPlateMutedBrush}"
                                       Text="Estimate a missing product price using the trained ML.NET model."
                                       TextWrapping="Wrap" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,6"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource FlatPlateInkBrush}"
                                               Text="Ingredient" />
                                    <ComboBox x:Name="IngredientComboBox"
                                              AutomationProperties.Name="Ingredient"
                                              Style="{StaticResource FormComboBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,6"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource FlatPlateInkBrush}"
                                               Text="Store" />
                                    <ComboBox x:Name="StoreComboBox"
                                              AutomationProperties.Name="Store"
                                              Style="{StaticResource FormComboBox}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,14,0,6"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource FlatPlateInkBrush}"
                                       Text="Pack size (g, mL, or pieces)" />
                            <TextBox x:Name="PackSizeTextBox"
                                     Width="180"
                                     HorizontalAlignment="Left"
                                     AutomationProperties.Name="Pack size"
                                     Style="{StaticResource FormTextBox}"
                                     Text="1000" />

                            <Button x:Name="PredictPriceButton"
                                    Margin="0,14,0,0"
                                    HorizontalAlignment="Left"
                                    MinWidth="130"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Estimate price" />

                            <Border Margin="0,14,0,0"
                                    Padding="12,10"
                                    Background="#F0F5F1"
                                    CornerRadius="8">
                                <TextBlock x:Name="PredictedPriceText"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource FlatPlateInkBrush}"
                                           Text="No estimate yet"
                                           TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource FlatPlateMutedBrush}"
                                       Text="Model estimates are guidance only and are not verified supermarket prices."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
