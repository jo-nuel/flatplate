<UserControl x:Class="FlatPlate.App.Views.RecipeLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FlatPlate.App.ViewModels"
             Background="{StaticResource FlatPlateCanvasBrush}">
    <UserControl.DataContext><vm:RecipeLibraryViewModel /></UserControl.DataContext>
    <UserControl.Resources>
        <DrawingImage x:Key="RecipePlaceholderImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#EDF5EF">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,200,72" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#D1E5D6">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="100,36" RadiusX="28" RadiusY="24" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#F9FBFA">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="100,36" RadiusX="20" RadiusY="17" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#2E855F">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="96,32" RadiusX="5" RadiusY="10" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#4EA476">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="105,40" RadiusX="5" RadiusY="10" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#E2A65B">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="109,28" RadiusX="4" RadiusY="4" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <Style x:Key="PanelBorderStyle" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="ConnectedButtonStyle" TargetType="Button" BasedOn="{StaticResource TertiaryButton}">
            <Style.Triggers><DataTrigger Binding="{Binding Actions}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ConnectedPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Style.Triggers><DataTrigger Binding="{Binding Actions}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24,22,24,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="MEAL IDEAS" Style="{StaticResource PageEyebrow}" />
            <TextBlock Text="Recipe Library" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Browse household recipes and review ingredient totals for their base servings." Style="{StaticResource PageDescription}" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="155" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Label Content="_Search" Target="{Binding ElementName=RecipeSearchTextBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" x:Name="RecipeSearchTextBox" AutomationProperties.Name="Search recipes by name" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,12,0" />
            <Label Grid.Column="2" Content="_Cuisine" Target="{Binding ElementName=CuisineFilterComboBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="3" x:Name="CuisineFilterComboBox" AutomationProperties.Name="Recipe cuisine filter" ItemsSource="{Binding CuisineOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedCuisine}" Style="{StaticResource FormComboBox}" Margin="0,0,12,0" />
            <Button Grid.Column="4" x:Name="AddRecipeButton" AutomationProperties.Name="Add recipe" Content="_Add Recipe" Command="{Binding Actions.AddRecipeCommand}" Style="{StaticResource ConnectedPrimaryButtonStyle}" Margin="0,0,8,0" />
            <Button Grid.Column="5" x:Name="ReloadRecipesButton" Content="_Refresh" Command="{Binding Actions.ReloadCommand}" Style="{StaticResource ConnectedButtonStyle}" />
            <Button Grid.Row="1" Grid.ColumnSpan="6" x:Name="ImportRecipeCsvButton"
                    AutomationProperties.Name="Import recipe catalogue from two CSV files"
                    Content="_Import Recipe CSVs" Command="{Binding Actions.ImportRecipeCsvCommand}"
                    Style="{StaticResource ConnectedButtonStyle}" Margin="0,8,0,0"
                    HorizontalAlignment="Right" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="310" /><ColumnDefinition Width="14" /><ColumnDefinition Width="2*" MinWidth="260" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Recipes" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ListBox Grid.Row="1" x:Name="RecipeCardsListBox" AutomationProperties.Name="Recipe catalogue"
                             ItemsSource="{Binding VisibleRecipes}" SelectedItem="{Binding SelectedRecipe}" IsSynchronizedWithCurrentItem="False"
                             Background="Transparent" BorderThickness="0" SelectionMode="Single"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,8,8" /><Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                        </Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border Width="200" Padding="12" BorderThickness="1" CornerRadius="10">
                                <Border.Style><Style TargetType="Border">
                                    <Setter Property="Background" Value="#F9FBFA" /><Setter Property="BorderBrush" Value="{StaticResource FlatPlateBorderBrush}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource FlatPlateFocusBrush}" /></Trigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Background" Value="{StaticResource FlatPlateGreenSoftBrush}" /><Setter Property="BorderBrush" Value="{StaticResource FlatPlateGreenBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style></Border.Style>
                                <StackPanel>
                                    <Grid Height="72" Margin="0,0,0,10" Background="#EAF2ED">
                                        <Image Source="{StaticResource RecipePlaceholderImage}" Stretch="UniformToFill" AutomationProperties.Name="Recipe placeholder artwork">
                                            <Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding HasImage}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Image.Style>
                                        </Image>
                                        <Image Source="{Binding Image}" Stretch="UniformToFill" AutomationProperties.Name="Recipe image">
                                            <Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasImage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Image.Style>
                                        </Image>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding CuisineDisplay}" Foreground="{StaticResource FlatPlateGreenBrush}" TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,6,0,0"><TextBlock Text="{Binding PrepMinutes, StringFormat={}{0} min}" Margin="0,0,12,0" Foreground="{StaticResource FlatPlateMutedBrush}" /><TextBlock Text="{Binding BaseServings, StringFormat={}{0} servings}" Foreground="{StaticResource FlatPlateMutedBrush}" /></WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="1" x:Name="EmptyRecipesPanel" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=RecipeCardsListBox}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel><TextBlock x:Name="EmptyRecipesTitle" Text="{Binding EmptyTitle}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource FlatPlateInkBrush}" /><TextBlock Text="{Binding EmptyDescription}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource FlatPlateMutedBrush}" MaxWidth="240" Margin="0,8,0,0" /></StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Recipe Details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBlock Grid.Row="1" Text="Select a recipe to see its details." Foreground="{StaticResource FlatPlateMutedBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedRecipe}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer Grid.Row="1" DataContext="{Binding SelectedRecipe}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CuisineDisplay}" Foreground="{StaticResource FlatPlateGreenBrush}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding PrepMinutes, StringFormat={}{0} prep minutes}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding BaseServings, StringFormat={}{0} base servings}" Margin="0,4,0,10" />
                            <TextBlock Text="{Binding QuantityNotice}" Foreground="{StaticResource FlatPlateMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ItemsControl x:Name="SelectedIngredientsList" ItemsSource="{Binding Ingredients}" AutomationProperties.Name="Ingredient totals for selected recipe">
                                <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource FlatPlateBorderBrush}" BorderThickness="0,0,0,1" Padding="0,6"><StackPanel>
                                    <TextBlock Text="{Binding IngredientName}" FontWeight="SemiBold" TextWrapping="Wrap" /><WrapPanel><TextBlock Text="{Binding AmountDisplay}" TextWrapping="Wrap" Margin="0,0,6,0" /><TextBlock Text="{Binding UnitDisplay}" /></WrapPanel>
                                </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" x:Name="EditRecipeButton" AutomationProperties.Name="Edit selected recipe" Content="_Edit Recipe" Command="{Binding Actions.EditRecipeCommand}" Padding="12,6" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ConnectedPrimaryButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedRecipe}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" x:Name="RecipeStatusText" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#5A5047" /><Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="#B3261E" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <Expander Grid.Row="4" x:Name="PendingRecipeDraftsPanel" Header="Pending recipe drafts — not saved" IsExpanded="True" Margin="0,10,0,0">
            <Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasPendingDrafts}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Expander.Style>
            <StackPanel><TextBlock Text="The drafts below are not saved. They remain in memory only while this screen is open." Foreground="#5A5047" TextWrapping="Wrap" Margin="0,4,0,4" /><ListBox x:Name="PendingRecipeDraftsList" ItemsSource="{Binding PendingDrafts}" DisplayMemberPath="Summary" MaxHeight="70" AutomationProperties.Name="Confirmed recipe drafts, not saved" /></StackPanel>
        </Expander>
    </Grid>
</UserControl>
