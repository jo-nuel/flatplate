<UserControl x:Class="FlatPlate.App.Views.RecipeLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:FlatPlate.Core.Models;assembly=FlatPlate.Core"
             Background="#FFF8F1">
    <UserControl.Resources>
        <!-- section heading used by the recipe list and details panels -->
        <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- white bordered panel used for the recipe list and details areas -->
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E6DCCF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Recipe Library"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,4" />

            <TextBlock Text="Browse the household recipes, filter them by cuisine and select a recipe to see its details."
                       Foreground="#5A5047"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- toolbar: Phase 1 static UI, no search, filter or add behaviour yet -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Search"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />

            <TextBox x:Name="RecipeSearchTextBox"
                     Grid.Column="1"
                     Padding="6,5"
                     VerticalContentAlignment="Center"
                     Margin="0,0,10,0" />

            <ComboBox x:Name="CuisineFilterComboBox"
                      Grid.Column="2"
                      SelectedIndex="0"
                      Padding="8,5"
                      VerticalContentAlignment="Center"
                      Margin="0,0,10,0">
                <ComboBoxItem Content="All cuisines" />
            </ComboBox>

            <Button x:Name="AddRecipeButton"
                    Grid.Column="3"
                    Content="Add Recipe"
                    Padding="14,7" />
        </Grid>

        <!-- content: recipe list on the left, selected recipe details on the right -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- recipe list panel -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Recipes"
                               Style="{StaticResource SectionTitleTextStyle}" />

                    <!-- recipe cards; empty-library message: Step 5 -->
                    <Grid Grid.Row="1">
                        <ListBox x:Name="RecipeCardsListBox"
                                 SelectionMode="Single"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <!-- the card draws its own hover and selection states -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,10,10" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Recipe}">
                                    <Border Width="200"
                                            Padding="12"
                                            CornerRadius="6"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFCF7" />
                                                <Setter Property="BorderBrush" Value="#E6DCCF" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#D4B896" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                 Value="True">
                                                        <Setter Property="Background" Value="#FFF1E3" />
                                                        <Setter Property="BorderBrush" Value="#C8742C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,4" />

                                            <TextBlock Text="{Binding Cuisine}"
                                                       Foreground="#8A5A2B"
                                                       Margin="0,0,0,8" />

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding PrepMinutes, StringFormat={}{0} min}"
                                                           Foreground="#5A5047"
                                                           Margin="0,0,12,0" />

                                                <TextBlock Text="{Binding BaseServings, StringFormat={}{0} servings}"
                                                           Foreground="#5A5047" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- empty library message, hidden automatically once the list has items -->
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="380"
                                Margin="12"
                                Padding="24,20"
                                Background="#FFF8F1"
                                BorderBrush="#E6DCCF"
                                BorderThickness="1"
                                CornerRadius="6"
                                IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=RecipeCardsListBox}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <TextBlock Text="No recipes yet"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#8A5A2B"
                                           TextAlignment="Center"
                                           Margin="0,0,0,6" />

                                <TextBlock Text="Add your first recipe to start building your library."
                                           Foreground="#5A5047"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- recipe details panel -->
            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Recipe Details"
                               Style="{StaticResource SectionTitleTextStyle}" />

                    <!-- selected recipe fields above, Edit Recipe button pinned below -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- shown while no recipe is selected -->
                        <TextBlock Grid.Row="0"
                                   Text="Select a recipe to see its details."
                                   Foreground="#5A5047"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=RecipeCardsListBox}"
                                                     Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- selected recipe fields -->
                        <ScrollViewer Grid.Row="0"
                                      DataContext="{Binding SelectedItem, ElementName=RecipeCardsListBox}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=RecipeCardsListBox}"
                                                     Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <StackPanel>
                                <StackPanel.Resources>
                                    <Style x:Key="DetailLabelTextStyle" TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#8A5A2B" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Margin" Value="0,10,0,2" />
                                    </Style>
                                </StackPanel.Resources>

                                <TextBlock Text="{Binding Name}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />

                                <TextBlock Text="Cuisine" Style="{StaticResource DetailLabelTextStyle}" />
                                <TextBlock Text="{Binding Cuisine}" FontSize="14" TextWrapping="Wrap" />

                                <TextBlock Text="Prep time" Style="{StaticResource DetailLabelTextStyle}" />
                                <TextBlock Text="{Binding PrepMinutes, StringFormat={}{0} minutes}" FontSize="14" />

                                <TextBlock Text="Base servings" Style="{StaticResource DetailLabelTextStyle}" />
                                <TextBlock Text="{Binding BaseServings}" FontSize="14" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Phase 1 static UI: no edit behaviour yet, enabled only while a recipe is selected -->
                        <Button x:Name="EditRecipeButton"
                                Grid.Row="1"
                                Content="Edit Recipe"
                                Padding="14,7"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=RecipeCardsListBox}"
                                                     Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
