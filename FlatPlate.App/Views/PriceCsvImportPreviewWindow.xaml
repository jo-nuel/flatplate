<Window x:Class="FlatPlate.App.Views.PriceCsvImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Price CSV Import Preview" Width="1000" Height="660" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F3F8F2">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="3*" /><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Price CSV Import Preview" FontSize="24" FontWeight="Bold" />
        <StackPanel Grid.Row="1" Margin="0,8,0,10">
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="#4F5F4C" />
            <TextBlock Text="{Binding Summary}" Margin="0,6,0,0" FontWeight="SemiBold" />
        </StackPanel>
        <TextBlock Grid.Row="2" Text="Parsed records — catalogue and duplicate review" FontWeight="SemiBold" Margin="0,0,0,6" />
        <DataGrid Grid.Row="3" x:Name="PreviewRowsGrid" ItemsSource="{Binding Rows}"
                  AutomationProperties.Name="Parsed CSV records, preview only"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Parsed row" Binding="{Binding ParsedRow}" Width="70" />
                <DataGridTextColumn Header="Ingredient" Binding="{Binding Record.IngredientName}" Width="*" MinWidth="120" />
                <DataGridTextColumn Header="Store" Binding="{Binding Record.StoreName}" Width="100" />
                <DataGridTextColumn Header="Price (AUD)" Binding="{Binding PriceDisplay}" Width="110" />
                <DataGridTextColumn Header="Pack" Binding="{Binding PackDisplay}" Width="140" />
                <DataGridTextColumn Header="Observed" Binding="{Binding Record.LastUpdated}" Width="190" />
                <DataGridTextColumn Header="Source" Binding="{Binding Record.Source}" Width="85" />
                <DataGridTextColumn Header="Review" Binding="{Binding ReviewStatus}" Width="115" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="4" Text="Errors and decisions — no rows will be saved" FontWeight="SemiBold" Margin="0,12,0,6" />
        <DataGrid Grid.Row="5" x:Name="PreviewIssuesGrid" ItemsSource="{Binding Issues}"
                  AutomationProperties.Name="CSV row errors and pending decisions"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="110" />
                <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="120" />
                <DataGridTextColumn Header="Issue" Binding="{Binding Message}" Width="*" MinWidth="320">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="Margin" Value="4" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="6" x:Name="ClosePreviewButton" Content="_Close Preview" IsCancel="True" IsDefault="True"
                Click="OnClose" HorizontalAlignment="Right" Padding="16,7" Margin="0,12,0,0" />
    </Grid>
</Window>
