<UserControl x:Class="FlatPlate.App.Views.ShoppingListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource FlatPlateCanvasBrush}">
    <Grid Margin="24,22,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Style="{StaticResource PageEyebrow}"
                       Text="YOUR WEEKLY SHOP" />
            <TextBlock Style="{StaticResource PageTitle}"
                       Text="Shopping List" />
            <TextBlock Style="{StaticResource PageDescription}"
                       Text="Tick items as you shop, record what you paid, and compare the remaining basket across stores." />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,14"
                Padding="18,14"
                Style="{StaticResource SurfaceCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CompareStoresButton"
                        MinWidth="132"
                        Style="{StaticResource PrimaryButton}"
                        Content="Compare stores" />
                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="CheapestStoreText"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource FlatPlateInkBrush}"
                               Text="Cheapest store: Not calculated" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource FlatPlateMutedBrush}"
                               Text="Right-click an item if you already have it at home."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource SurfaceCard}"
                Padding="0">
            <Grid>
                <DataGrid x:Name="ShoppingListGrid"
                          AutomationProperties.Name="Weekly shopping list"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource FlatPlateBorderBrush}"
                          BorderThickness="0"
                          Background="White">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="38" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Already have it"
                                                  IsCheckable="True"
                                                  IsChecked="{Binding AlreadyHave,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource FlatPlateHoverBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsPurchased}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource FlatPlateGreenSoftBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AlreadyHave}" Value="True">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <Expander IsExpanded="True"
                                                          Background="White">
                                                    <Expander.Header>
                                                        <Border Padding="12,9"
                                                                Background="#F0F5F1"
                                                                BorderBrush="{StaticResource FlatPlateBorderBrush}"
                                                                BorderThickness="0,1,0,1">
                                                            <TextBlock FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource FlatPlateGreenDarkBrush}"
                                                                       Text="{Binding Name}" />
                                                        </Border>
                                                    </Expander.Header>
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ingredient"
                                            Binding="{Binding IngredientName}"
                                            IsReadOnly="True"
                                            Width="*"
                                            MinWidth="160" />
                        <DataGridTextColumn Header="Amount"
                                            Binding="{Binding RequiredAmount, StringFormat={}{0:0.##}}"
                                            IsReadOnly="True"
                                            Width="90" />
                        <DataGridTextColumn Header="Unit"
                                            Binding="{Binding Unit}"
                                            IsReadOnly="True"
                                            Width="80" />
                        <DataGridTextColumn Header="Aisle"
                                            Binding="{Binding Aisle}"
                                            IsReadOnly="True"
                                            Width="120" />
                        <DataGridCheckBoxColumn Header="Purchased"
                                                Binding="{Binding IsPurchased,
                                                                  Mode=TwoWay,
                                                                  UpdateSourceTrigger=PropertyChanged}"
                                                Width="95" />
                        <DataGridTextColumn Header="Amount paid ($)"
                                            Width="130">
                            <DataGridTextColumn.Binding>
                                <Binding Path="ActualPrice"
                                         Mode="TwoWay"
                                         UpdateSourceTrigger="LostFocus"
                                         ValidatesOnDataErrors="True"
                                         ValidatesOnExceptions="True"
                                         NotifyOnValidationError="True" />
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBox}" />
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="390"
                        Padding="28,24"
                        Background="#F8FBF9"
                        BorderBrush="{StaticResource FlatPlateBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=ShoppingListGrid}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource FlatPlateInkBrush}"
                                   Text="Your shopping list is empty" />
                        <TextBlock Margin="0,8,0,0"
                                   TextAlignment="Center"
                                   Foreground="{StaticResource FlatPlateMutedBrush}"
                                   Text="Add meals in Weekly Planner and their ingredients will appear here automatically."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Padding="18,12"
                Background="{StaticResource FlatPlateInkBrush}"
                CornerRadius="10">
            <DockPanel>
                <TextBlock x:Name="ActualSpendingText"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="$0.00" />
                <StackPanel>
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#BFD8CA"
                               Text="ACTUAL SPENDING" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="White"
                               Text="Purchased items with an amount paid" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
