<Window x:Class="FlatPlate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:FlatPlate.App.Views"
        mc:Ignorable="d"
        Title="FlatPlate"
        Height="720"
        Width="1180"
        MinHeight="520"
        MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <TabControl>
        <TabItem Header="Recipe Library">
            <views:RecipeLibraryView />
        </TabItem>
        <TabItem Header="Price Book">
            <views:PriceBookView />
        </TabItem>
        <TabItem Header="Weekly Planner">
            <views:WeeklyPlannerView x:Name="WeeklyPlanner" />
        </TabItem>
        <TabItem Header="Shopping List">
            <views:ShoppingListView />
        </TabItem>
        <TabItem Header="Insights">
            <views:InsightsView />
        </TabItem>
    </TabControl>
</Window>
